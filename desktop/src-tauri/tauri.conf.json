{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI题库控制台",
  "version": "0.1.0",
  "identifier": "com.aitiku.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI 题库控制台",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
